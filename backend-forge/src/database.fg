import postgres;
import web;
extern fn portfolio_pool(): int;
fn args1(value: string): int { let values: int = web.array(); web.push(values, web.jstring(value)); return values; }
fn args2(a: string, b: string): int { let values: int = args1(a); web.push(values, web.jstring(b)); return values; }
fn query(conn: int, sql: string, values: int): int {
    let params: int = postgres.params();
    let index: int = 0;
    while (index < web.count(values)) {
        let value: int = web.at(values, index);
        if (web.kind(value) == 0) { postgres.push_null(params); }
        else { postgres.push(params, web.text(value)); }
        index = index + 1;
    }
    let result: int = postgres.query(conn, sql, params);
    postgres.params_close(params);
    return result;
}
fn guarded_response(conn: int, request: int, sql: string): int {
    let guarded: string = str_concat("WITH gate AS MATERIALIZED (SELECT EXISTS(SELECT 1 FROM banned_ips WHERE ip=$1 AND (expires_at IS NULL OR expires_at>now())) AS banned) SELECT banned,CASE WHEN banned THEN NULL::json ELSE (", str_concat(sql, ") END FROM gate"));
    let params: int = postgres.params();
    postgres.push(params, web.ip(request));
    let result: int = postgres.query_prepared(conn, guarded, params);
    postgres.params_close(params);
    let success: int = 0;
    if (postgres.ok(result) == 0 || postgres.rows(result) != 1) { success = web.error(request, 500, "internal"); }
    else {
        if (web.equal(postgres.value(result, 0, 0), "t") != 0) { success = web.error(request, 403, "forbidden"); }
        else { success = web.respond(request, 200, postgres.value(result, 0, 1)); }
    }
    postgres.clear(result);
    return success;
}
fn fetch(conn: int, sql: string, values: int): int {
    let result: int = query(conn, sql, values);
    let value: int = 0;
    if (postgres.ok(result) != 0 && postgres.rows(result) > 0) { value = web.parse(postgres.value(result, 0, 0)); }
    postgres.clear(result);
    return value;
}
fn response(conn: int, request: int, sql: string, values: int, status: int): int {
    let result: int = query(conn, sql, values);
    let success: int = 0;
    if (postgres.ok(result) == 0) {
        let state: string = postgres.state(result);
        if (web.starts(state, "22") != 0 || web.equal(state, "23502") != 0 || web.equal(state, "23514") != 0) { success = web.validation(request, "invalid field value"); }
        else { success = web.error(request, 500, "internal"); }
    } else {
        if (status == 204) {
            if (postgres.affected(result) == 0) { success = web.error(request, 404, "not_found"); }
            else { success = web.respond(request, 204, ""); }
        } else {
            if (postgres.rows(result) == 0) { success = web.error(request, 404, "not_found"); }
            else { success = web.respond(request, status, postgres.value(result, 0, 0)); }
        }
    }
    postgres.clear(result);
    return success;
}
fn exists(conn: int, sql: string, values: int): int {
    let result: int = query(conn, sql, values);
    let value: int = -1;
    if (postgres.ok(result) != 0 && postgres.rows(result) > 0) { value = web.equal(postgres.value(result, 0, 0), "t"); }
    postgres.clear(result);
    return value;
}

fn response_once(request: int, sql: string, values: int, status: int): int {
    let conn: int = postgres.acquire(portfolio_pool());
    if (conn == 0) { return web.error(request, 503, "unavailable"); }
    let result: int = response(conn, request, sql, values, status);
    postgres.release(portfolio_pool(), conn);
    return result;
}
