import postgres;
import web;
import routes;
extern fn portfolio_pool_set(pool: int): int;
extern fn portfolio_run(host: string, port: int, workers: int): int;
fn migrations(conn: int): int {
    if (postgres.migration_table(conn) == 0) { return 0; }
    if (postgres.migrate(conn, 1, "init", web.read("backend/migrations/0001_init.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 2, "projects", web.read("backend/migrations/0002_projects.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 3, "contact_messages", web.read("backend/migrations/0003_contact_messages.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 4, "comments", web.read("backend/migrations/0004_comments.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 5, "seed_projects", web.read("backend/migrations/0005_seed_projects.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 6, "project_demo_url", web.read("backend/migrations/0006_project_demo_url.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 7, "project_repo_meta_and_attachments", web.read("backend/migrations/0007_project_repo_meta_and_attachments.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 8, "timeline", web.read("backend/migrations/0008_timeline.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 9, "post_numeric_ids", web.read("backend/migrations/0009_post_numeric_ids.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 10, "bans", web.read("backend/migrations/0010_bans.sql")) == 0) { return 0; }
    if (postgres.migrate(conn, 11, "restore_comment_post_index", web.read("backend/migrations/0011_restore_comment_post_index.sql")) == 0) { return 0; }
    return 1;
}
fn run(): int {
    web.scope_begin();
    if (web.chars(web.env("DATABASE_URL", "")) == 0 || web.chars(web.env("JWT_SECRET", "")) == 0) { println("DATABASE_URL and JWT_SECRET are required"); web.scope_end(); return 1; }
    let pool: int = postgres.pool_open(web.env("DATABASE_URL", ""), web.integer(web.parse(web.env("DATABASE_POOL_SIZE", "5"))));
    if (pool == 0) { println("PostgreSQL connection failed"); web.scope_end(); return 1; }
    let conn: int = postgres.acquire(pool);
    let ready: int = migrations(conn);
    postgres.release(pool, conn);
    if (ready == 0) { println("Database migrations failed"); postgres.pool_close(pool); web.scope_end(); return 1; }
    portfolio_pool_set(pool);
    web.scope_end();
    let result: int = portfolio_run(web.env("HOST", "0.0.0.0"), web.integer(web.parse(web.env("PORT", "8080"))), 8);
    postgres.pool_close(pool); web.scope_end(); return result;
}
