import database;
import web;
import postgres;
extern fn portfolio_post_summaries(request: int, result: int, guarded: int): int;
fn validate(body: int, create: int): int {
    if (web.kind(body) != 4) { return 0; }
    if (create != 0 && web.required(body, "title", 3) == 0) { return 0; }
    if (web.optional(body, "title", 3) == 0) { return 0; }
    if (create != 0 && web.required(body, "excerpt", 3) == 0) { return 0; }
    if (web.optional(body, "excerpt", 3) == 0) { return 0; }
    if (create != 0 && web.required(body, "content_markdown", 3) == 0) { return 0; }
    if (web.optional(body, "content_markdown", 3) == 0) { return 0; }
    if (create != 0 && web.required(body, "published", 1) == 0) { return 0; }
    if (web.optional(body, "published", 1) == 0) { return 0; }
    if (web.present(body, "title") != 0 && web.chars(web.trim(web.field_text(body, "title"))) == 0) { return 0; }
    return 1;
}
fn list(conn: int, request: int, all: int): int {
    let sql: string = "SELECT p.id,p.title,p.excerpt,to_json(p.created_at),COUNT(c.post_id) AS comment_count FROM posts p LEFT JOIN comments c ON c.post_id=p.id WHERE p.published=true GROUP BY p.id ORDER BY p.created_at DESC";
    if (all != 0) { sql = "SELECT p.id,p.title,p.excerpt,to_json(p.created_at),COUNT(c.post_id) AS comment_count FROM posts p LEFT JOIN comments c ON c.post_id=p.id GROUP BY p.id ORDER BY p.created_at DESC"; }
    return list_response(conn, request, sql, 0);
}
fn public_list(conn: int, request: int): int {
    // A banned gate sets LIMIT 0, skipping aggregation without a per-comment filter.
    return list_response(conn, request, "WITH gate AS MATERIALIZED (SELECT EXISTS(SELECT 1 FROM banned_ips WHERE ip=$1 AND (expires_at IS NULL OR expires_at>now())) AS banned) SELECT gate.banned,item.id,item.title,item.excerpt,to_json(item.created_at),item.comment_count FROM gate LEFT JOIN LATERAL (SELECT p.id,p.title,p.excerpt,p.created_at,COUNT(c.post_id) AS comment_count FROM posts p LEFT JOIN comments c ON c.post_id=p.id WHERE p.published=true GROUP BY p.id LIMIT CASE WHEN gate.banned THEN 0 ELSE NULL END) item ON true ORDER BY item.created_at DESC", 1);
}
fn list_response(conn: int, request: int, sql: string, guarded: int): int {
    let params: int = postgres.params();
    if (guarded != 0) { postgres.push(params, web.ip(request)); }
    let result: int = postgres.query_prepared(conn, sql, params);
    postgres.params_close(params);
    let success: int = 0;
    if (postgres.ok(result) == 0 || (guarded != 0 && postgres.rows(result) == 0)) { success = web.error(request, 500, "internal"); }
    else {
        if (guarded != 0 && web.equal(postgres.value(result, 0, 0), "t") != 0) { success = web.error(request, 403, "forbidden"); }
        else { success = portfolio_post_summaries(request, result, guarded); }
    }
    postgres.clear(result);
    return success;
}
fn save(conn: int, request: int, id: string, create: int): int {
    let body: int = web.request_json(request);
    if (validate(body, create) == 0) { return web.validation(request, "invalid or missing field"); }
    if (create != 0) { return database.response(conn, request, "WITH changed AS (INSERT INTO posts(title,excerpt,content_markdown,published) SELECT (jsonb_populate_record(NULL::posts,$1::jsonb)).title,(jsonb_populate_record(NULL::posts,$1::jsonb)).excerpt,(jsonb_populate_record(NULL::posts,$1::jsonb)).content_markdown,(jsonb_populate_record(NULL::posts,$1::jsonb)).published RETURNING *) SELECT row_to_json(changed) FROM changed", database.args1(web.dump(body)), 201); }
    return database.response(conn, request, "WITH changed AS (UPDATE posts SET title=COALESCE((jsonb_populate_record(NULL::posts,$1::jsonb)).title,title),excerpt=COALESCE((jsonb_populate_record(NULL::posts,$1::jsonb)).excerpt,excerpt),content_markdown=COALESCE((jsonb_populate_record(NULL::posts,$1::jsonb)).content_markdown,content_markdown),published=COALESCE((jsonb_populate_record(NULL::posts,$1::jsonb)).published,published),updated_at=now() WHERE id=$2::bigint RETURNING *) SELECT row_to_json(changed) FROM changed", database.args2(web.dump(body), id), 200);
}
fn remove(conn: int, request: int, id: string): int { return database.response(conn, request, "DELETE FROM posts WHERE id=$1::bigint", database.args1(id), 204); }
fn get(conn: int, request: int, id: string, all: int): int {
    if (all != 0) { return database.response(conn, request, "SELECT row_to_json(p) FROM posts p WHERE id=$1::bigint", database.args1(id), 200); }
    return database.response(conn, request, "SELECT row_to_json(p) FROM posts p WHERE id=$1::bigint AND published=true", database.args1(id), 200);
}
