FROM node:22-alpine AS builder
RUN apk add --no-cache build-base cmake
WORKDIR /repo
COPY backend-forge/toolchain backend-forge/toolchain
RUN cmake -S backend-forge/toolchain -B backend-forge/build/toolchain -DCMAKE_BUILD_TYPE=Release && cmake --build backend-forge/build/toolchain --target forge -j 4
COPY backend-forge/vendor/forge-browser backend-forge/vendor/forge-browser
COPY backend-forge/vendor/forge-web/web.fg backend-forge/vendor/forge-web/web.fg
COPY frontend-forge frontend-forge
RUN npm ci --prefix backend-forge/vendor/forge-browser && npm ci --prefix frontend-forge && npm run build --prefix frontend-forge
FROM nginx:1.27-alpine
COPY --from=builder /repo/frontend-forge/dist /usr/share/nginx/html
COPY frontend-forge/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
