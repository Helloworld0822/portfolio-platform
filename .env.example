DATABASE_URL=postgres://blog:blog@postgres:5432/portfolio_blog
JWT_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USERNAME=Helloworld0822
FRONTEND_URL=http://localhost/
BACKEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
# Optional GitHub fine-grained token. Without it, repo language/privacy
# metadata is fetched anonymously (rate-limited, private repos report 404 and
# stay "public").
GITHUB_TOKEN=
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=portfolio_blog
HOST_HTTP_PORT=80
# Google AdSense publisher id (ca-pub-...). Baked into the frontend build;
# changing it requires `docker compose up -d --build nginx`. Leave empty
# until the site is registered with AdSense.
VITE_ADSENSE_CLIENT_ID=
